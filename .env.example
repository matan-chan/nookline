# Copy to .env next to docker-compose.yml, then edit values.

# Auth signing secret (≥32 random chars in production). Leave empty for Docker:
# the backend entrypoint generates one and saves it to /data/.jwt_secret on the data volume.
JWT_SECRET=

# Host folder holding uploaded books/libraries (created if missing — path relative to this file ok)
BOOKS_BIND=./books

BACKEND_PORT=4005
FRONTEND_PORT=3009

# Vite dev (`frontend`: npm start): proxies /api here. If unset, falls back to BACKEND_PORT then 4006.
# Set DEV_BACKEND_PORT=4006 when the API runs only via backend/.env PORT (local `bun run dev`).

# TTS upstream (OpenAI-compatible / Kokoro-style). Default matches the bundled Kokoro service name.
# Without the "kokoro" Compose profile: set this to your own TTS URL, or AI voice features will fail upstream.
# Older setups may use KOKORO_TTS_URL; TTS_URL takes precedence.
TTS_URL=http://kokoro-nookline:8880
