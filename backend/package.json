{
  "name": "nookline-backend",
  "version": "0.1.5",
  "scripts": {
    "typecheck:test": "tsc --noEmit -p test/tsconfig.json",
    "test": "bun test",
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "db:deploy": "bun scripts/runPrismaWithDefaultDb.ts migrate deploy",
    "db:generate": "bun scripts/runPrismaWithDefaultDb.ts generate",
    "db:migrate": "bun scripts/runPrismaWithDefaultDb.ts migrate dev",
    "db:push": "bun scripts/runPrismaWithDefaultDb.ts db push",
    "db:delete-all-users": "bun run scripts/deleteAllUsers.ts"
  },
  "dependencies": {
    "@apollo/server": "^4.11.0",
    "@napi-rs/canvas": "^0.1.80",
    "@prisma/client": "^5.17.0",
    "@types/multer": "^2.1.0",
    "express": "^4.19.2",
    "graphql": "^16.9.0",
    "jszip": "^3.10.1",
    "multer": "^2.1.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "bun-types": "^1.3.12",
    "prisma": "^5.17.0",
    "typescript": "^5.5.3"
  }
}
