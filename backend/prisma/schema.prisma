generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                 Int               @id @default(autoincrement())
  email              String            @unique
  username           String            @unique
  password           String
  isAdmin            Boolean           @default(false)
  avatarRelPath      String?
  ttsMode            String            @default("kokoro")
  ttsCustomBaseUrl   String?
  ttsCustomApiKey    String?
  ttsVoice           String            @default("af_heart")
  ttsModel           String            @default("kokoro")
  ttsSpeed           Float             @default(1.0)
  ttsPitch           Float             @default(1.0)
  ttsChunkMinChars   Int               @default(200)
  ttsChunkMaxChars   Int               @default(300)
  ttsChunkPeriodExtra Int             @default(1500)
  ttsReaderShowPage  Boolean         @default(true)
  ttsReaderShowTitle Boolean         @default(true)
  ttsReaderStripPdfMargins Boolean   @default(true)
  ttsReaderDarkDocument Boolean       @default(false)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  readingProgress    ReadingProgress[]
  bookmarks          Bookmark[]
  highlights         Highlight[]
  voiceProfiles      VoiceProfile[]
  bookFavorites      BookFavorite[]
  libraries          Library[]
}

model AppCustomization {
  id              Int      @id @default(1)
  siteName        String?
  faviconRelPath  String?
  convertPdfToEpub Boolean @default(false)
  updatedAt       DateTime @updatedAt
}

model CustomLibraryBanner {
  id        Int       @id @default(autoincrement())
  relPath   String
  createdAt DateTime  @default(now())
  libraries Library[]
}

// type: MANGA | NOVEL | COMIC
model Library {
  id                     Int                  @id @default(autoincrement())
  userId                 Int                  @default(1)
  name                   String
  path                   String
  type                   String               @default("NOVEL")
  bannerIndex            Int                  @default(0)
  customLibraryBannerId  Int?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  user                   User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  customLibraryBanner    CustomLibraryBanner? @relation(fields: [customLibraryBannerId], references: [id], onDelete: SetNull)
  series                 Series[]
  books                  Book[]
}

// status: ONGOING | COMPLETED | HIATUS | CANCELLED
model Series {
  id             Int      @id @default(autoincrement())
  libraryId      Int
  title          String
  description    String?
  coverImagePath String?
  metadata       String?
  status         String   @default("ONGOING")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  library        Library  @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  books          Book[]
}

model Book {
  id              Int               @id @default(autoincrement())
  libraryId       Int
  seriesId        Int?
  title           String
  filePath        String
  coverImagePath  String?
  volumeNumber    Float?
  metadata        String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  library         Library           @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  series          Series?           @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  readingProgress ReadingProgress[]
  bookmarks       Bookmark[]
  highlights      Highlight[]
  favorites       BookFavorite[]

  @@unique([libraryId, filePath])
}

model BookFavorite {
  id        Int      @id @default(autoincrement())
  userId    Int
  bookId    Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
}

model ReadingProgress {
  id         Int      @id @default(autoincrement())
  userId     Int
  bookId     Int
  position   String   @default("0")
  percentage Float    @default(0)
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  book       Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
}

model Bookmark {
  id        Int      @id @default(autoincrement())
  userId    Int
  bookId    Int
  position  String
  note      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
}

model Highlight {
  id        Int      @id @default(autoincrement())
  userId    Int
  bookId    Int
  startPos  String
  endPos    String
  text      String
  color     String   @default("#ba9eff")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
}

model VoiceProfile {
  id        Int      @id @default(autoincrement())
  userId    Int
  name      String
  modelId   String
  speed     Float    @default(1.0)
  pitch     Float    @default(1.0)
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
